@@ -3232,12 +3232,36 @@
 				const Transform externalMetricGuess =
 					externalLoopClosureHypothesis == _loopClosureHypothesis.first
 					? externalLoopClosureMetricTransform : Transform();
-				transform = _memory->computeTransform(
-						_loopClosureHypothesis.first,
-						signature->id(),
-						!externalMetricGuess.isNull() ? externalMetricGuess :
