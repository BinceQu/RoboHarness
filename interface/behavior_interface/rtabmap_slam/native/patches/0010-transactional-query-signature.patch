+bool Memory::addQueryLink(const Link & link)
+{
+	UASSERT(link.type() > Link::kNeighbor && link.type() != Link::kUndef);
+	Signature * toS = _getSignature(link.to());
+	Signature * fromS = _getSignature(link.from());
+	if(!toS || !fromS || toS->hasLink(link.from()) ||
+	   fromS->hasLink(link.to()))
+	{
+		return false;
+	}
+	toS->addLink(link.inverse());
+	fromS->addLink(link);
+	if(_incrementalMemory && link.type() != Link::kVirtualClosure)
+	{
+		// Query topology is finalized as one transaction. In particular, do not
+		// transfer C's accumulated weight to the provisional Q node: only Q is
+		// persisted at commit, so ordinary addLink() weight transfer would make a
+		// crash/reopen count the same observations in both C and Q.
+		_linksChanged = true;
+	}
+	return true;
+}
+
+void Memory::persistLink(const Link & link)
+{
+	UASSERT(_dbDriver != 0);
+	UASSERT(_dbDriver->isConnected());
+	const Signature * from = _getSignature(link.from());
+	const Signature * to = _getSignature(link.to());
+	UASSERT(from != 0 && to != 0 && from->isSaved() && to->isSaved());
+	std::multimap<int, Link> persisted;
+	_dbDriver->loadLinks(link.from(), persisted);
+	bool found = false;
+	for(std::multimap<int, Link>::const_iterator iter=persisted.begin();
+			iter!=persisted.end(); ++iter)
+	{
+		if(iter->second.to() == link.to())
+		{
+			found = true;
+			break;
+		}
+	}
+	if(found)
+	{
+		_dbDriver->updateLink(link);
+	}
+	else
+	{
+		_dbDriver->addLink(link);
+	}
+}
