+	UASSERT(data.gridCellSize() > 0.0f);
+	UASSERT(neighborId > 0 && _memory->getSignature(neighborId) != 0);
+	UASSERT(uContains(_optimizedPoses, neighborId));
+	UASSERT(!neighborTransform.isNull() && neighborTransform.isInvertible());
+	UASSERT(!odomPose.isNull() && odomPose.isInvertible());
+	UASSERT(!optimizedPose.isNull() && optimizedPose.isInvertible());
+	UASSERT(odomCovariance.rows == 6 && odomCovariance.cols == 6 && odomCovariance.type() == CV_64FC1);
