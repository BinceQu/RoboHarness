+
+bool Rtabmap::addQueryLink(const Link & link)
+{
+	UASSERT(_pendingQuerySignatureId > 0);
+	UASSERT(link.from() != link.to());
+	UASSERT(link.type() == Link::kGlobalClosure);
+	UASSERT(link.from() == _pendingQuerySignatureId ||
+			link.to() == _pendingQuerySignatureId);
+	const int peerId = link.from() == _pendingQuerySignatureId ?
+			link.to() : link.from();
+	const Signature * peer = _memory->getSignature(peerId);
+	UASSERT(peer != 0 && peer->isSaved());
+	return addLinkImpl(link, true);
+}
