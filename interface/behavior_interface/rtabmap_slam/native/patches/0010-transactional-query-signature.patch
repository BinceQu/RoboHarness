+	return _memory->updateQuerySignaturePayload(
+			id, ground, obstacles, empty, cellSize, viewPoint, holdingUserData);
+}
+
+bool Rtabmap::finalizeQuerySignature(int id, const cv::Mat & terminalUserData)
+{
+	UASSERT(_memory != 0 && _memory->isIncremental());
+	UASSERT(id > 0 && id == _pendingQuerySignatureId);
+	const Signature * signature = _memory->getSignature(id);
+	UASSERT(signature != 0);
+	UASSERT(!signature->isSaved());
+	UASSERT(!terminalUserData.empty());
+	std::vector<int> endpointIds;
+	endpointIds.reserve(signature->getLinks().size());
+	for(std::multimap<int, Link>::const_iterator iter=signature->getLinks().begin();
+			iter!=signature->getLinks().end(); ++iter)
+	{
+		UASSERT(iter->second.from() == id);
+		UASSERT(iter->second.to() > 0 && iter->second.to() != id);
+		UASSERT(iter->second.type() == Link::kNeighbor ||
+				iter->second.type() == Link::kGlobalClosure);
+		const Signature * endpoint = _memory->getSignature(iter->second.to());
+		UASSERT(endpoint != 0 && endpoint->isSaved());
+		endpointIds.push_back(iter->second.to());
+	}
+	UASSERT(!endpointIds.empty());
+	// Complete every recoverable topology check before mutating user data or
+	// queueing an asynchronous save. A failed preflight therefore leaves both
+	// RAM and the durable database untouched.
+	_memory->joinTrashThread();
+	UASSERT(_memory->setUserData(id, terminalUserData));
+	_memory->save2DMap(cv::Mat(), 0, 0, 0);
+	_memory->saveLocationData(id);
+	_memory->flushTrashSynchronously();
+	const bool finalized = _memory->getSignature(id) != 0 &&
+				_memory->getSignature(id)->isSaved();
+	if(finalized)
+	{
+		_pendingQuerySignatureId = 0;
+	}
+	return finalized;
+}
