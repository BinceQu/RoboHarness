+void Memory::checkpointResidentSignatures()
+{
+	UASSERT(_dbDriver != 0 && !_dbDriver->isInMemory());
+	// Do not let an older async writer split this checkpoint into multiple
+	// transactions. The caller guarantees that no provisional link exists yet.
+	joinTrashThread();
+	std::set<int> durableIds;
+	_dbDriver->getAllNodeIds(durableIds, false, false, false);
+	std::vector<int> unsavedIds;
+	for(std::map<int, Signature *>::const_iterator iter=_signatures.begin();
+			iter!=_signatures.end(); ++iter)
+	{
+		const Signature * signature = iter->second;
+		if(!signature || signature->id() <= 0)
+		{
+			continue;
+		}
+		for(std::multimap<int, Link>::const_iterator linkIter=signature->getLinks().begin();
+				linkIter!=signature->getLinks().end(); ++linkIter)
+		{
+			const int peerId = linkIter->second.to();
+			UASSERT(peerId <= 0 || peerId == signature->id() ||
+					_signatures.find(peerId) != _signatures.end() ||
+					durableIds.find(peerId) != durableIds.end());
+		}
+		if(!signature->isSaved())
+		{
+			unsavedIds.push_back(signature->id());
+		}
+	}
+	for(std::vector<int>::const_iterator iter=unsavedIds.begin();
+			iter!=unsavedIds.end(); ++iter)
+	{
+		saveLocationData(*iter);
+	}
+	flushTrashSynchronously();
+	if(!unsavedIds.empty())
+	{
+		durableIds.clear();
+		_dbDriver->getAllNodeIds(durableIds, false, false, false);
+		for(std::vector<int>::const_iterator iter=unsavedIds.begin();
+				iter!=unsavedIds.end(); ++iter)
+		{
+			UASSERT(durableIds.find(*iter) != durableIds.end());
+		}
+	}
+}
+
+void Memory::flushTrashSynchronously()
+{
+	if(_dbDriver)
+	{
+		_dbDriver->join();
+		_dbDriver->emptyTrashes(false);
+	}
+}
