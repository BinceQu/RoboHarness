+	_querySignatureAnchorId = neighborId;
+	_querySignatureOptimizedPose = optimizedPose;
+	_querySignatureNeighborTransform = neighborTransform;
+	_querySignatureInsertedId = 0;
+	try
+	{
+		const bool processed = process(data, odomPose, odomCovariance);
+		const int insertedId = _querySignatureInsertedId;
+		// All recoverable validation is performed above. Once process() enters
+		// Memory::update(), a false result cannot be proven side-effect free
+		// (feature dictionary/preUpdate state may already have changed), so it is
+		// a fail-stop condition rather than a retryable zero-id outcome.
+		UASSERT_MSG(processed && insertedId > 0 &&
+					_memory->getSignature(insertedId) != 0,
+					"Transactional query insertion did not retain exactly one signature");
+		_pendingQuerySignatureId = insertedId;
+		_querySignatureProcessing = false;
+		_querySignatureAnchorId = 0;
+		_querySignatureNeighborTransform.setNull();
+		_querySignatureOptimizedPose.setNull();
+		_querySignatureInsertedId = 0;
+		return insertedId;
+	}
+	catch(...)
+	{
+		_querySignatureProcessing = false;
+		_querySignatureAnchorId = 0;
+		_querySignatureNeighborTransform.setNull();
+		_querySignatureOptimizedPose.setNull();
+		_querySignatureInsertedId = 0;
