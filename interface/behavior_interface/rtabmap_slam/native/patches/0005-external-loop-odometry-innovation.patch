+void Rtabmap::setExternalLoopClosureHypothesis(
+		int id,
+		const Transform & expectedCurrentToCandidate,
+		const cv::Mat & odometryCovariance,
+		double innovationChiSquareThreshold)
+{
+	const bool valid = id > 0 &&
+		!expectedCurrentToCandidate.isNull() &&
+		odometryCovariance.rows == 3 &&
+		odometryCovariance.cols == 3 &&
+		odometryCovariance.type() == CV_64FC1 &&
+		cv::checkRange(odometryCovariance, true, 0) &&
+		odometryCovariance.at<double>(0,0) >= 0.0 &&
+		odometryCovariance.at<double>(1,1) >= 0.0 &&
+		odometryCovariance.at<double>(2,2) >= 0.0 &&
+		innovationChiSquareThreshold > 0.0 &&
+		std::isfinite(innovationChiSquareThreshold);
+	_externalLoopClosureHypothesis = valid ? id : 0;
+	_externalLoopClosureOdomTransform = valid ? expectedCurrentToCandidate : Transform();
+	_externalLoopClosureOdomCovariance = valid ? odometryCovariance.clone() : cv::Mat();
+	_externalLoopClosureInnovationChiSquareThreshold =
+		valid ? innovationChiSquareThreshold : 0.0;
 }
 
