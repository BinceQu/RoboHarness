# Hosted in the asset dataset and pinned in ../../assets.lock.json. Each
# workspace's setup.sh restores them with scripts/fetch_assets.py.
*.obj
*.stl
*.STL
*.glb
*.dae
*.npz
*.npy
*.whl
# The repository ignores *.lock; this one pins the workspace environment.
!/R1_pro/requirements.lock

# Per-workspace environments and session state.
.python/
.runtime/
.session.json
perception/*
!perception/README.md
tool_call_history/*
!tool_call_history/README.md
skills/active.json
